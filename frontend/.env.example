# Copy to .env. Set VITE_USE_MOCK=false to use the real backend (via Vite proxy).
VITE_USE_MOCK=false

# Leave empty: relative URLs go through the Vite dev proxy (vite.config.ts).
VITE_API_URL=

# true  = use VITE_TENANT_ID + VITE_AUTH_TOKEN below (local dev / testing)
# false = read tenant + token from parent Joblogic sessionStorage (iframe / production)
VITE_USE_HARDCODED_AUTH=true

# Used only when VITE_USE_HARDCODED_AUTH=true.
VITE_TENANT_ID=
VITE_AUTH_TOKEN=
