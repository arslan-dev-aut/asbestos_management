# =============================================================================
# B6 Asbestos Management — backend environment template.
# Copy to backend/.env and fill in the values for local development.
# =============================================================================

# --- General ---
APPLICATION_ENVIRONMENT=development
API_BASE_PREFIX=/api/v1/asbestos

# --- Azure App Configuration (production credential source) ---
# Set at the Container App level by the deploy pipeline. In production,
# AppConfigManager.load() reads Automation/<AUTOMATION_NAME>/* into the env.
APP_CONFIGURATION_CONNECTION_STRING=
AUTOMATION_NAME=asbestos-management

# --- Database (Azure PostgreSQL, Entra/token auth) ---
# No connection string is committed. Provide discrete parts; the access token
# is fetched at runtime (managed identity in prod, `az login` locally).
DB_AUTH_MODE=aad_token
DB_HOST=<your-server>.postgres.database.azure.com
DB_PORT=5432
DB_NAME=automation-asbestos
DB_USER=<entra-principal-or-managed-identity-name>
DB_SSL_MODE=require
AAD_TOKEN_SCOPE=https://ossrdbms-aad.database.windows.net/.default
# User-assigned managed identity client id (prod; set by deploy pipeline):
AZURE_CLIENT_ID=
DB_ECHO=false

# Local-only alternative (non-Azure dev): set DB_AUTH_MODE=password and supply
# a full URL here. Leave blank for Entra auth.
# DB_AUTH_MODE=password
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/automation-asbestos

# --- Auth (JobLogic Identity Server; multi-tenant marketplace) ---
# Tenant comes from the X-Tenant-Id header via joblogic_sdk.auth.get_tenant_id.
IDP_CLIENT_ID=
IDP_AUTHORITY=
JWT_USER_CLAIM=sub
# Local dev only: trust X-Tenant-Id header without a bearer token.
AUTH_DEV_FALLBACK=true
DEV_USER_ID=00000000-0000-0000-0000-000000000000

# --- Jicro API (SDK — used by ODataClient and JicroClient) ---
# These are the standard SDK env vars consumed by ODataClient and JicroClient.
# Values are environment-specific; get them from the platform team.
#   UAT:     https://jluatmainsubsysautomationapi.azurewebsites.net
#   Staging: https://jlstagmainsubsysautomationapi.azurewebsites.net
#   Prod:    https://mainsubsysautomationapi.joblogic.com
# In production both values are loaded from Azure App Config at startup
# (keys: Automation/asbestos-management/JICRO_BASE_URL and JICRO_AUTH_TOKEN).
JICRO_BASE_URL=
JICRO_AUTH_TOKEN=

# --- Azure Blob Storage ---
# Default: Entra/managed-identity auth (account URL + DefaultAzureCredential).
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=Asbestos-Management
# Optional local-dev alternative (don't commit a real one):
# AZURE_STORAGE_CONNECTION_STRING=
BLOB_SAS_EXPIRY_SECONDS=900
# Optional CDN/base for QR images (else a SAS URL is used):
STORAGE_PUBLIC_BASE_URL=

# --- Public QR page ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Business rules ---
AMP_EXPIRY_WARNING_DAYS=30
NOTES_MAX_LENGTH=250
NOTES_TRUNCATE_LENGTH=100
MAX_UPLOAD_BYTES=26214400

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,https://go.joblogic.com
