# =============================================================================
# B6 Asbestos Management — backend environment template.
# Copy to backend/.env and fill in the values for local development.
#
# UAT / Staging / Production: all values are stored in Azure App Configuration
# under the key prefix Automation/<AUTOMATION_NAME>/* and injected into the
# environment at startup by AppConfigManager.load(). The only two variables
# set directly on the Container App are APP_CONFIGURATION_CONNECTION_STRING
# and AUTOMATION_NAME.
# =============================================================================

# --- General ---
APPLICATION_ENVIRONMENT=
API_BASE_PREFIX=
PROJECT_NAME=

# --- Azure App Configuration ---
APP_CONFIGURATION_CONNECTION_STRING=
AUTOMATION_NAME=

# --- Database (Azure PostgreSQL) ---
# DB_AUTH_MODE: aad_token (managed identity / az login) | password (local only)
DB_AUTH_MODE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_SSL_MODE=
AAD_TOKEN_SCOPE=
AZURE_CLIENT_ID=
# Full connection URL — only needed when DB_AUTH_MODE=password (local dev).
DATABASE_URL=
DB_ECHO=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# --- Auth (JobLogic Identity Server) ---
IDP_CLIENT_ID=
IDP_AUTHORITY=
IDP_CLIENT_SECRET=
JWT_USER_CLAIM=
INTROSPECT_REDIRECT_URL=
# AUTH_DEV_FALLBACK=true trusts X-Tenant-Id without a bearer token (local dev only).
AUTH_DEV_FALLBACK=
DEV_USER_ID=

# --- Jicro API (SDK — consumed by ODataClient and JicroClient) ---
JICRO_BASE_URL=
JICRO_AUTH_TOKEN=

# --- User identity resolution ---
USER_DETAIL_API_BASE_URL=

# --- Azure Blob Storage ---
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
# Optional: connection string for local dev instead of managed identity.
AZURE_STORAGE_CONNECTION_STRING=
BLOB_SAS_EXPIRY_SECONDS=
# Optional: CDN base URL for QR images; leave blank to use SAS URLs.
STORAGE_PUBLIC_BASE_URL=

# --- Public QR page ---
PUBLIC_BASE_URL=

# --- Business rules ---
AMP_EXPIRY_WARNING_DAYS=
NOTES_MAX_LENGTH=
NOTES_TRUNCATE_LENGTH=
MAX_UPLOAD_BYTES=
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# --- CORS (comma-separated list of allowed origins) ---
CORS_ALLOW_ORIGINS=
